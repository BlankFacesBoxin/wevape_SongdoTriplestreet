FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-preview.txt ./
RUN pip install --no-cache-dir -r requirements-preview.txt
COPY preview_site/ preview_site/
COPY dashboard/server.py dashboard/server.py
COPY dashboard/static/index.html dashboard/static/app.js dashboard/static/style.css dashboard/static/
COPY pos_parser.py ./
RUN useradd --uid 10001 --create-home preview
USER preview
CMD ["sh", "-c", "exec gunicorn preview_site.wsgi:application --bind 0.0.0.0:${PORT:-10000} --workers 1 --threads 2 --timeout 60 --access-logfile - --error-logfile -"]
